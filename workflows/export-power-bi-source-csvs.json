    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://odoo.example.com/json/2/sale.order/search_read",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"domain\": [[\"state\", \"=\", \"sale\"]],\n  \"fields\": [\n    \"name\",\n    \"date_order\",\n    \"partner_id\",\n    \"state\",\n    \"invoice_status\",\n    \"currency_id\",\n    \"amount_untaxed\",\n    \"amount_tax\",\n    \"amount_total\"\n  ],\n  \"order\": \"id asc\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -48,
        -16
      ],
      "id": "18377099-4406-4bf5-8bc9-5fc0602ce95e",
      "name": "Read Odoo Sales Orders"
    },
    {
      "parameters": {
        "jsCode": "const invoiceStatusLabels = {\n  no: 'Nothing to Invoice',\n  'to invoice': 'To Invoice',\n  invoiced: 'Fully Invoiced',\n  upselling: 'Upselling Opportunity',\n};\n\nreturn $input.all().map(({ json: order }) => {\n  const date = DateTime.fromFormat(\n    order.date_order,\n    'yyyy-MM-dd HH:mm:ss',\n    { zone: 'UTC' }\n  ).setZone('Asia/Beirut');\n\n  return {\n    json: {\n      'Order Reference': order.name,\n      'Order Date': date.toFormat('yyyy-MM-dd HH:mm:ss'),\n      'Customer': order.partner_id?.[1] ?? '',\n      'Total': order.amount_total,\n      'Status': 'Sales Order',\n      'Invoice Status': invoiceStatusLabels[order.invoice_status] ?? order.invoice_status,\n      'Currency': order.currency_id?.[1] ?? '',\n      'Untaxed Amount': order.amount_untaxed,\n      'Taxes': order.amount_tax,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        -16
      ],
      "id": "6df947ae-f307-4486-bb13-a8224ee5e136",
      "name": "Format Sales Rows"
    },
    {
      "parameters": {
        "options": {
          "fileName": "cedarline-sales-orders.csv",
          "headerRow": true
        }
      },
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.2,
      "position": [
        400,
        -16
      ],
      "id": "9f248da1-b2ce-4d07-a465-811fabcf48e0",
      "name": "Convert to File"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://odoo.example.com/json/2/purchase.order/search_read",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"domain\": [[\"state\", \"=\", \"purchase\"]],\n  \"fields\": [\n    \"name\", \"date_approve\", \"partner_id\", \"amount_total\",\n    \"invoice_status\", \"date_planned\", \"currency_id\",\n    \"amount_untaxed\", \"amount_tax\", \"state\", \"receipt_status\"\n  ],\n  \"order\": \"id asc\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -48,
        192
      ],
      "id": "c2e7cdf3-4436-455e-8196-4afcb6731240",
      "name": "Read Odoo Purchase Orders"
    },
    {
      "parameters": {
        "jsCode": "const billingLabels = {\n  no: 'Nothing to Bill',\n  'to invoice': 'Waiting Bills',\n  invoiced: 'Fully Billed',\n};\n\nconst receiptLabels = {\n  pending: 'Not Received',\n  partial: 'Partially Received',\n  full: 'Fully Received',\n};\n\nfunction beirutDate(value) {\n  if (!value) return '';\n  const format = 'yyyy-MM-dd HH:mm:ss';\n  return DateTime.fromFormat(value, format, { zone: 'UTC' })\n    .setZone('Asia/Beirut')\n    .toFormat(format);\n}\n\nreturn $input.all().map(({ json: order }) => ({\n  json: {\n    'Order Reference': order.name,\n    'Order Date': beirutDate(order.date_approve),\n    'Vendor': order.partner_id?.[1] ?? '',\n    'Total': order.amount_total,\n    'Billing Status': billingLabels[order.invoice_status] ?? (order.invoice_status || ''),\n    'Expected Arrival': beirutDate(order.date_planned),\n    'Currency': order.currency_id?.[1] ?? '',\n    'Untaxed Amount': order.amount_untaxed,\n    'Taxes': order.amount_tax,\n    'Status': 'Purchase Order',\n    'Receipt Status': receiptLabels[order.receipt_status] ?? (order.receipt_status || ''),\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        192
      ],
      "id": "f1d732c1-b020-4fd2-bf3d-9433a6bc9239",
      "name": "Format Purchase Rows"
    },
    {
      "parameters": {
        "options": {
          "fileName": "cedarline-purchase-orders.csv",
          "headerRow": true
        }
      },
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.2,
      "position": [
        400,
        192
      ],
      "id": "73470308-2443-4663-943c-be8430b9ed11",
      "name": "Convert to File1"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://odoo.example.com/json/2/stock.quant/search_read",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"domain\": [\n    [\"location_id.usage\", \"=\", \"internal\"],\n    [\"location_id.warehouse_id\", \"!=\", false]\n  ],\n  \"fields\": [\n    \"location_id\", \"product_id\", \"quantity\",\n    \"reserved_quantity\", \"available_quantity\"\n  ],\n  \"order\": \"id asc\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        -48,
        416
      ],
      "id": "092e728d-a6ca-468e-8c19-b3f797b9212e",
      "name": "Read Odoo Inventory"
