      "position": [
        400,
        416
      ],
      "id": "82cfaf03-8952-4053-8320-06b42fb9a9d3",
      "name": "Convert to File2"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(({ json: stock }) => ({\n  json: {\n    'Location': stock.location_id[1],\n    'Product': stock.product_id[1],\n    'Inventoried Quantity': stock.quantity,\n    'Reserved Quantity': stock.reserved_quantity,\n    'Available Quantity': stock.available_quantity,\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
